  "nodes": {
    "var_e2e9b3e036ec": {
      "type": "variant",
      "label": "Aira — Scroll-heavy homepage clone",
      "parentId": null,
      "themeId": null,
      "rect": {
        "x": 0,
        "y": 0,
        "w": 1440,
        "h": 800
      },
      "html": "<link data-kid=\"1\" data-name=\"lenis scroll library stylesheet\" href=\"https://unpkg.com/lenis@1/dist/lenis.css\" rel=\"stylesheet\"/>\n<div class=\"w-full bg-[#f9f8f6] text-[#1c1d1f] font-sans overflow-x-clip\" data-kid=\"2\" data-name=\"page wrapper\" id=\"smooth-wrapper\">\n    <div data-kid=\"2-1\" data-name=\"main content container\" id=\"smooth-content\">\n        <style>\n            @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&family=Roboto+Mono:wght@400;500&display=swap');\n      \n      :root {\n        --color-bg-light: #f9f8f6;\n        --color-bg-light-alt: #f0efed;\n        --color-bg-dark: #080808;\n        --color-text-primary: #1c1d1f;\n        --color-text-secondary: #70706f;\n        --font-serif: \"Gestura Headline\", Georgia, serif;\n        --font-sans: \"Inter\", sans-serif;\n        --font-mono: \"Roboto Mono\", monospace;\n      }\n\n      body {\n        background-color: var(--color-bg-light);\n        color: var(--color-text-primary);\n        font-family: var(--font-sans);\n      }\n\n      .font-serif { font-family: var(--font-serif); }\n      .font-mono { font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.2em; text-transform: uppercase; }\n      \n      .btn-pill-light {\n        padding: 0.6rem 1.5rem;\n        border-radius: 9999px;\n        font-size: 0.875rem;\n        font-weight: 500;\n        background-color: white;\n        color: black;\n        transition: background-color 0.2s;\n      }\n      .btn-pill-dark {\n        padding: 0.6rem 1.5rem;\n        border-radius: 9999px;\n        font-size: 0.875rem;\n        font-weight: 500;\n        background-color: var(--color-bg-dark);\n        color: white;\n        transition: background-color 0.2s;\n      }\n      .btn-pill-outline {\n        padding: 0.6rem 1.5rem;\n        border-radius: 9999px;\n        font-size: 0.875rem;\n        font-weight: 500;\n        border: 1px solid rgba(255,255,255,0.2);\n        color: white;\n      }\n\n      .divider-line {\n        height: 1px;\n        background-color: rgba(0,0,0,0.1);\n        width: 100%;\n        transform-origin: left;\n      }\n      .divider-line-dark {\n        height: 1px;\n        background-color: rgba(255,255,255,0.1);\n        width: 100%;\n        transform-origin: left;\n      }\n\n      .lenis.lenis-smooth { scroll-behavior: auto !important; }\n      .lenis.lenis-smooth [data-lenis-prevent] { overscroll-behavior: contain; }\n      .lenis.lenis-stopped { overflow: hidden; }\n\n      .reveal-text {\n        overflow: hidden;\n      }\n\n      .hero-title-mask {\n        clip-path: polygon(0 0, 100% 0, 100% 100%, 0 100%);\n      }\n\n      .feature-row-pinned {\n        display: flex;\n        align-items: center;\n        min-height: 100vh;\n      }\n\n      /* Custom animations classes */\n      .reveal-up { transform: translateY(40px); opacity: 0; }\n      #main-nav.is-light .nav-link-item,\n      #main-nav.is-light .logo-text,\n      #main-nav.is-light .logo-svg { color: var(--color-text-primary) !important; }\n      #main-nav.is-light .nav-btn-signin { background-color: rgba(0,0,0,0.05) !important; color: var(--color-text-primary) !important; }\n      #main-nav.is-light .nav-btn-demo { background-color: var(--color-bg-dark) !important; color: white !important; }\n        </style>\n        <!-- Header -->\n        <header class=\"fixed top-4 left-4 right-4 w-auto z-[100] flex items-center justify-between px-10 py-6\" data-dynamic=\"true\" data-kid=\"2-1-1\" data-name=\"floating main navigation bar\" data-reason=\"classes toggled by scroll to change appearance\" id=\"main-nav\">\n            <div class=\"flex items-center gap-12\" data-kid=\"2-1-1-1\" data-name=\"logo and navigation links container\">\n                <a class=\"flex items-center gap-2 group\" data-kid=\"2-1-1-1-1\" data-name=\"logo brand link\" href=\"/\">\n                    <svg class=\"w-6 h-6 text-white transition-colors duration-300 logo-svg\" data-kid=\"2-1-1-1-1-1\" data-name=\"brand logo icon\" fill=\"currentColor\" viewbox=\"0 0 24 24\">\n                        <path d=\"M12 2L13.8 8.8L20.8 10.6L14 12.4L12.2 19.2L10.4 12.4L3.6 10.6L10.6 8.8L12 2Z\">\n                        </path>\n                    </svg>\n                    <span class=\"text-xl font-semibold tracking-tight text-white transition-colors duration-300 logo-text\" data-kid=\"2-1-1-1-1-2\" data-name=\"brand name text\">\n                        Aira\n                    </span>\n                </a>\n                <nav class=\"hidden lg:flex items-center gap-8\" data-kid=\"2-1-1-1-2\" data-name=\"main navigation menu\">\n                    <a class=\"text-sm font-medium text-white/80 hover:text-white nav-link-item\" data-kid=\"2-1-1-1-2-1\" data-name=\"about us link\" href=\"#\">\n                        About us\n                    </a>\n                    <a class=\"text-sm font-medium text-white/80 hover:text-white nav-link-item\" data-kid=\"2-1-1-1-2-2\" data-name=\"hubspot integration link\" href=\"#\">\n                        Aira for HubSpot\n                    </a>\n                    <a class=\"text-sm font-medium text-white/80 hover:text-white nav-link-item\" data-kid=\"2-1-1-1-2-3\" data-name=\"news link\" href=\"#\">\n                        News\n                    </a>\n                    <a class=\"text-sm font-medium text-white/80 hover:text-white nav-link-item\" data-kid=\"2-1-1-1-2-4\" data-name=\"events link\" href=\"#\">\n                        Events\n                    </a>\n                    <a class=\"text-sm font-medium text-white/80 hover:text-white nav-link-item\" data-kid=\"2-1-1-1-2-5\" data-name=\"revenue journal link\" href=\"#\">\n                        Revenue Journal\n                    </a>\n                    <div class=\"flex items-center gap-1 text-sm font-medium text-white/80 hover:text-white nav-link-item cursor-pointer\" data-kid=\"2-1-1-1-2-6\" data-name=\"investor relations dropdown\">\n                        Investor relations\n                        <svg class=\"w-3 h-3\" data-kid=\"2-1-1-1-2-6-1\" data-name=\"dropdown chevron icon\" fill=\"none\" stroke=\"currentColor\" viewbox=\"0 0 24 24\">\n                            <path d=\"M19 9l-7 7-7-7\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\">\n                            </path>\n                        </svg>\n                    </div>\n                </nav>\n            </div>\n            <div class=\"flex items-center gap-4\" data-kid=\"2-1-1-2\" data-name=\"navigation call-to-action buttons container\">\n                <a class=\"px-5 py-2 rounded-full bg-white/10 text-white text-sm font-medium hover:bg-white/20 transition-colors nav-btn-signin\" data-kid=\"2-1-1-2-1\" data-name=\"sign in button\" href=\"#\">\n                    Sign in\n                </a>\n                <a class=\"px-5 py-2 rounded-full bg-white text-black text-sm font-medium hover:bg-gray-100 transition-colors nav-btn-demo\" data-kid=\"2-1-1-2-2\" data-name=\"book a demo button\" href=\"#\">\n                    Book a demo\n                </a>\n            </div>\n        </header>\n        <!-- Hero Section -->\n        <section class=\"relative w-full h-[100vh] min-h-[800px] bg-[#f9f8f6] p-4 flex flex-col items-center\" data-kid=\"2-1-2\" data-name=\"hero section\" id=\"hero-section\">\n            <div class=\"relative w-full h-full rounded-[2.5rem] overflow-hidden\" data-kid=\"2-1-2-1\" data-name=\"hero panel container\" id=\"hero-panel\">\n                <img alt=\"Aira Hero\" class=\"absolute inset-0 w-full h-full object-cover scale-110\" data-kid=\"2-1-2-1-1\" data-name=\"hero background image\" decoding=\"async\" id=\"hero-img\" loading=\"lazy\" src=\"https://cdn.prod.website-files.com/68513e75563291f5d48ada9b/69ea37052c990e8169de4d0a_b557de67bc1083414afb951fc7bae5ce_hero%20bg%20img-p-2000.webp?auto=format&w=2000&q=80&fit=crop\"/>\n                <div class=\"absolute inset-0 bg-black/30\" data-kid=\"2-1-2-1-2\" data-name=\"hero image overlay\">\n                </div>\n                <div class=\"absolute inset-0 flex flex-col justify-end p-20 pb-32\" data-kid=\"2-1-2-1-3\" data-name=\"hero content container\">\n                    <div class=\"max-w-4xl\" data-kid=\"2-1-2-1-3-1\" data-name=\"hero text block\">\n                        <h1 class=\"font-serif text-white text-[5rem] md:text-[6.5rem] leading-[1.05] mb-10 hero-title-mask\" data-kid=\"2-1-2-1-3-1-1\" data-name=\"hero headline\">\n                            Surface opportunity and risk for every company in Europe\n                        </h1>\n                        <div class=\"flex flex-col md:flex-row items-end gap-12\" data-kid=\"2-1-2-1-3-1-2\" data-name=\"hero call-to-action area\">\n                            <p class=\"text-white/80 text-xl max-w-xl leading-relaxed\" data-kid=\"2-1-2-1-3-1-2-1\" data-name=\"hero description text\">\n                                Aira is the intelligence layer for European business. We connect the dots to surface growth opportunities and hidden risks for the companies you track.\n                            </p>\n                            <a class=\"px-10 py-4 rounded-full bg-white text-black text-lg font-medium hover:scale-105 active:scale-95 transition-transform duration-200 shrink-0\" data-kid=\"2-1-2-1-3-1-2-2\" data-name=\"primary book a demo button\" href=\"#\">\n                                Book a demo\n                            </a>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </section>\n        <!-- Product Intro Section -->\n        <section class=\"w-full bg-[#f9f8f6] py-40 px-10\" data-kid=\"2-1-3\" data-name=\"product intro section\">\n            <div class=\"max-w-7xl mx-auto\" data-kid=\"2-1-3-1\" data-name=\"section container\">\n                <div class=\"mb-32\" data-kid=\"2-1-3-1-1\" data-name=\"section header\">\n                    <div class=\"flex items-center gap-2 mb-10 reveal-up\" data-kid=\"2-1-3-1-1-1\" data-name=\"product section label\">\n                        <svg class=\"w-4 h-4 text-gray-400\" data-kid=\"2-1-3-1-1-1-1\" data-name=\"product icon\" fill=\"currentColor\" viewbox=\"0 0 24 24\">\n                            <path d=\"M12 2L13.8 8.8L20.8 10.6L14 12.4L12.2 19.2L10.4 12.4L3.6 10.6L10.6 8.8L12 2Z\">\n                            </path>\n                        </svg>\n                        <span class=\"font-mono text-gray-500\" data-kid=\"2-1-3-1-1-1-2\" data-name=\"section label text\">\n                            Products\n                        </span>\n                    </div>\n                    <h2 class=\"font-serif text-[4.5rem] text-[#1c1d1f] max-w-4xl leading-[1.1] mb-10 reveal-up\" data-kid=\"2-1-3-1-1-2\" data-name=\"section title\">\n                        Aira is the intelligence layer for European business.\n                    </h2>\n                    <p class=\"text-[#70706f] text-2xl max-w-2xl leading-relaxed reveal-up\" data-kid=\"2-1-3-1-1-3\" data-name=\"section description text\">\n                        Find growth opportunities and surface risks, powered by intelligence on 65 million companies across 14 markets.\n                    </p>\n                </div>\n                <div class=\"reveal-up\" data-kid=\"2-1-3-1-2\" data-name=\"investor section content\">\n                    <div class=\"divider-line mb-10\" data-kid=\"2-1-3-1-2-1\" data-name=\"divider line\">\n                    </div>\n                    <h3 class=\"font-serif text-3xl text-[#1c1d1f] mb-12\" data-kid=\"2-1-3-1-2-2\" data-name=\"section subtitle\">\n                        For investors, founders and CEOs\n                    </h3>\n                    <div class=\"relative w-full rounded-3xl overflow-hidden bg-black flex flex-col lg:flex-row min-h-[600px]\" data-kid=\"2-1-3-1-2-3\" data-name=\"investor feature card\">\n                        <div class=\"lg:w-1/2 p-16 flex flex-col justify-between\" data-kid=\"2-1-3-1-2-3-1\" data-name=\"feature card text area\">\n                            <div data-kid=\"2-1-3-1-2-3-1-1\" data-name=\"feature card label area\">\n                                <div class=\"flex items-center gap-3 mb-12\" data-kid=\"2-1-3-1-2-3-1-1-1\" data-name=\"feature card tag indicator\">\n                                    <span class=\"w-2 h-2 rounded-full bg-red-500 animate-pulse\" data-kid=\"2-1-3-1-2-3-1-1-1-1\" data-name=\"pulsing indicator\">\n                                    </span>\n                                    <span class=\"text-white/40 text-[10px] uppercase tracking-widest font-mono\" data-kid=\"2-1-3-1-2-3-1-1-1-2\" data-name=\"feature tag label\">\n                                        Deep Company Intelligence\n                                    </span>\n                                </div>\n                                <h4 class=\"font-serif text-white text-5xl leading-[1.2] mb-10\" data-kid=\"2-1-3-1-2-3-1-1-2\" data-name=\"feature card headline\">\n                                    Surface opportunity and risk on every investment or deal.\n                                </h4>\n                                <p class=\"text-white/50 text-xl leading-relaxed max-w-md mb-16\" data-kid=\"2-1-3-1-2-3-1-1-3\" data-name=\"feature card description\">\n                                    Aira monitors every company in Europe to connect the dots for you, and surface the moves that matter before the crowd.\n                                </p>\n                            </div>\n                            <a class=\"btn-pill-light w-fit text-base px-8 py-4\" data-kid=\"2-1-3-1-2-3-1-2\" data-name=\"feature card button\" href=\"#\">\n                                Book a demo\n                            </a>\n                        </div>\n                        <div class=\"lg:w-1/2 relative bg-[#141414] overflow-hidden min-h-[500px]\" data-kid=\"2-1-3-1-2-3-2\" data-name=\"feature card visual mockup\">\n                            <img class=\"absolute inset-0 w-full h-full object-cover opacity-50\" data-kid=\"2-1-3-1-2-3-2-1\" data-name=\"feature card background image\" decoding=\"async\" id=\"investor-panel-img\" loading=\"lazy\" src=\"https://cdn.prod.website-files.com/68513e75563291f5d48ada9b/69ef4da6d488608284e34ede_858d93c661e2f6af533ebbe230222d4e_desktop%20for%20website%2065-p-2000.webp?auto=format&w=1200&q=80&fit=crop\"/>\n                            <div class=\"absolute inset-0 flex flex-col justify-center px-12 space-y-6\" data-kid=\"2-1-3-1-2-3-2-2\" data-name=\"mockup info cards container\">\n                                <div class=\"bg-black/60 backdrop-blur-3xl border border-white/10 p-6 rounded-2xl transform translate-x-12 shadow-2xl max-w-[380px] self-end\" data-kid=\"2-1-3-1-2-3-2-2-1\" data-name=\"mockup info card 1\">\n                                    <div class=\"flex justify-between items-center mb-3\" data-kid=\"2-1-3-1-2-3-2-2-1-1\" data-name=\"info card header\">\n                                        <span class=\"text-white font-semibold text-base\" data-kid=\"2-1-3-1-2-3-2-2-1-1-1\" data-name=\"company name\">\n                                            Meridian Group\n                                        </span>\n                                        <span class=\"text-[9px] text-green-400 font-mono tracking-widest bg-green-400/10 px-2 py-0.5 rounded\" data-kid=\"2-1-3-1-2-3-2-2-1-1-2\" data-name=\"company signal tag\">\n                                            OPPORTUNITY\n                                        </span>\n                                    </div>\n                                    <p class=\"text-white/70 text-xs leading-relaxed mb-5\" data-kid=\"2-1-3-1-2-3-2-2-1-2\" data-name=\"company info text\">\n                                        Founder consolidated full ownership; revenue up 44% over three years.\n                                    </p>\n                                    <div class=\"flex gap-4 text-[8px] text-white/30 font-mono\" data-kid=\"2-1-3-1-2-3-2-2-1-3\" data-name=\"company meta data\">\n                                        <span data-kid=\"2-1-3-1-2-3-2-2-1-3-1\" data-name=\"meta location\">\n                                            UNITED KINGDOM\n                                        </span>\n                                        <span data-kid=\"2-1-3-1-2-3-2-2-1-3-2\" data-name=\"meta industry\">\n                                            LOGISTICS\n                                        </span>\n                                        <span data-kid=\"2-1-3-1-2-3-2-2-1-3-3\" data-name=\"meta size\">\n                                            €200-500M\n                                        </span>\n                                    </div>\n                                </div>\n                                <div class=\"bg-black/60 backdrop-blur-3xl border border-white/10 p-6 rounded-2xl transform -translate-x-4 shadow-2xl max-w-[380px]\" data-kid=\"2-1-3-1-2-3-2-2-2\" data-name=\"mockup info card 2\">\n                                    <div class=\"flex justify-between items-center mb-3\" data-kid=\"2-1-3-1-2-3-2-2-2-1\" data-name=\"info card header\">\n                                        <span class=\"text-white font-semibold text-base\" data-kid=\"2-1-3-1-2-3-2-2-2-1-1\" data-name=\"company name\">\n                                            Nexen Capital\n                                        </span>\n                                        <span class=\"text-[9px] text-red-400 font-mono tracking-widest bg-red-400/10 px-2 py-0.5 rounded\" data-kid=\"2-1-3-1-2-3-2-2-2-1-2\" data-name=\"company signal tag\">\n                                            RISK\n                                        </span>\n                                    </div>\n                                    <p class=\"text-white/70 text-xs leading-relaxed mb-5\" data-kid=\"2-1-3-1-2-3-2-2-2-2\" data-name=\"company info text\">\n                                        Revenue fell 27% in newly filed accounts; majority owner reducing stake.\n                                    </p>\n                                    <div class=\"flex gap-4 text-[8px] text-white/30 font-mono\" data-kid=\"2-1-3-1-2-3-2-2-2-3\" data-name=\"company meta data\">\n                                        <span data-kid=\"2-1-3-1-2-3-2-2-2-3-1\" data-name=\"meta location\">\n                                            STOCKHOLM\n                                        </span>\n                                        <span data-kid=\"2-1-3-1-2-3-2-2-2-3-2\" data-name=\"meta industry\">\n                                            PRIVATE EQUITY\n                                        </span>\n                                        <span data-kid=\"2-1-3-1-2-3-2-2-2-3-3\" data-name=\"meta size\">\n                                            €200-500M\n                                        </span>\n                                    </div>\n                                </div>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </section>\n        <!-- For B2B Sales -->\n        <section class=\"w-full bg-[#f9f8f6] py-32 px-10\" data-kid=\"2-1-4\" data-name=\"b2b sales section\">\n            <div class=\"max-w-7xl mx-auto\" data-kid=\"2-1-4-1\" data-name=\"section container\">\n                <div class=\"divider-line mb-10\" data-kid=\"2-1-4-1-1\" data-name=\"divider line\">\n                </div>\n                <h3 class=\"font-serif text-3xl text-[#1c1d1f] mb-12\" data-kid=\"2-1-4-1-2\" data-name=\"section title\">\n                    For B2B sales\n                </h3>\n                <div class=\"grid grid-cols-1 lg:grid-cols-2 gap-8\" data-kid=\"2-1-4-1-3\" data-name=\"features grid\">\n                    <!-- Aira Connect -->\n                    <div class=\"bg-white rounded-3xl p-16 flex flex-col justify-between min-h-[500px] border border-black/5\" data-kid=\"2-1-4-1-3-1\" data-name=\"crm integration card\">\n                        <div data-kid=\"2-1-4-1-3-1-1\" data-name=\"card content area\">\n                            <div class=\"flex items-center gap-3 mb-10\" data-kid=\"2-1-4-1-3-1-1-1\" data-name=\"card label\">\n                                <span class=\"w-2 h-2 rounded-full bg-green-500\" data-kid=\"2-1-4-1-3-1-1-1-1\" data-name=\"label dot\">\n                                </span>\n                                <span class=\"text-gray-400 text-[10px] font-mono\" data-kid=\"2-1-4-1-3-1-1-1-2\" data-name=\"label text\">\n                                    Aira Connect | CRM INTEGRATIONS\n                                </span>\n                            </div>\n                            <h4 class=\"font-serif text-4xl mb-8\" data-kid=\"2-1-4-1-3-1-1-2\" data-name=\"card title\">\n                                Enrich your CRM with verified company data.\n                            </h4>\n                            <p class=\"text-gray-500 text-lg leading-relaxed mb-12\" data-kid=\"2-1-4-1-3-1-1-3\" data-name=\"card description\">\n                                Keep every company in your CRM current with verified financials, contacts, and news. Import thousands of new companies in one click.\n                            </p>\n                            <!-- Integration Mockup -->\n                            <div class=\"relative py-24 flex items-center justify-center\" data-kid=\"2-1-4-1-3-1-1-4\" data-name=\"integration mockup\">\n                                <div class=\"flex flex-col gap-4 mr-24 relative z-10\" data-kid=\"2-1-4-1-3-1-1-4-1\" data-name=\"mockup tags\">\n                                    <div class=\"px-5 py-3 bg-[#f9f8f6] border border-black/5 rounded-full text-[9px] font-mono text-gray-400 shadow-xs ring-1 ring-black/5\" data-kid=\"2-1-4-1-3-1-1-4-1-1\" data-name=\"tag financials\">\n                                        FINANCIALS\n                                    </div>\n                                    <div class=\"px-5 py-3 bg-[#f9f8f6] border border-black/5 rounded-full text-[9px] font-mono text-gray-400 shadow-xs ring-1 ring-black/5\" data-kid=\"2-1-4-1-3-1-1-4-1-2\" data-name=\"tag contacts\">\n                                        CONTACTS\n                                    </div>\n                                    <div class=\"px-5 py-3 bg-[#f9f8f6] border border-black/5 rounded-full text-[9px] font-mono text-gray-400 shadow-xs ring-1 ring-black/5\" data-kid=\"2-1-4-1-3-1-1-4-1-3\" data-name=\"tag ownership\">\n                                        OWNERSHIP\n                                    </div>\n                                    <div class=\"px-5 py-3 bg-[#f9f8f6] border border-black/5 rounded-full text-[9px] font-mono text-gray-400 shadow-xs ring-1 ring-black/5\" data-kid=\"2-1-4-1-3-1-1-4-1-4\" data-name=\"tag news\">\n                                        NEWS MONITORING\n                                    </div>\n                                </div>\n                                <svg class=\"absolute left-[135px] top-[100px] w-[150px] h-[100px] pointer-events-none overflow-visible\" data-kid=\"2-1-4-1-3-1-1-4-2\" data-name=\"connection lines graphic\" fill=\"none\">\n                                    <path d=\"M0 -60 C 50 -60, 50 0, 110 0\" stroke=\"rgba(0,0,0,0.08)\" stroke-width=\"1\">\n                                    </path>\n                                    <path d=\"M0 -25 C 50 -25, 50 0, 110 0\" stroke=\"rgba(0,0,0,0.08)\" stroke-width=\"1\">\n                                    </path>\n                                    <path d=\"M0 10 C 50 10, 50 0, 110 0\" stroke=\"rgba(0,0,0,0.08)\" stroke-width=\"1\">\n                                    </path>\n                                    <path d=\"M0 45 C 50 45, 50 0, 110 0\" stroke=\"rgba(0,0,0,0.08)\" stroke-width=\"1\">\n                                    </path>\n                                    <circle cx=\"112\" cy=\"0\" fill=\"#22c55e\" r=\"3\">\n                                    </circle>\n                                </svg>\n                                <div class=\"px-10 py-6 bg-[#f9f8f6] rounded-2xl border border-black/5 flex items-center gap-4 shadow-md relative z-10 ring-1 ring-black/5\" data-kid=\"2-1-4-1-3-1-1-4-3\" data-name=\"crm mockup\">\n                                    <span class=\"text-[10px] font-mono text-gray-500 tracking-widest uppercase font-semibold\" data-kid=\"2-1-4-1-3-1-1-4-3-1\" data-name=\"crm label\">\n                                        Your CRM\n                                    </span>\n                                </div>\n                            </div>\n                        </div>\n                        <div class=\"flex items-center gap-6 mt-8\" data-kid=\"2-1-4-1-3-1-2\" data-name=\"card bottom area\">\n                            <a class=\"btn-pill-dark\" data-kid=\"2-1-4-1-3-1-2-1\" data-name=\"book a demo button\" href=\"#\">\n                                Book a demo\n                            </a>\n                            <div class=\"flex items-center gap-4 opacity-40\" data-kid=\"2-1-4-1-3-1-2-2\" data-name=\"partner logos\">\n                                <img alt=\"HubSpot\" class=\"h-4\" data-kid=\"2-1-4-1-3-1-2-2-1\" data-name=\"hubspot logo\" loading=\"lazy\" src=\"https://upload.wikimedia.org/wikipedia/commons/3/3e/HubSpot_Logo.svg\"/>\n                                <img alt=\"Salesforce\" class=\"h-6\" data-kid=\"2-1-4-1-3-1-2-2-2\" data-name=\"salesforce logo\" loading=\"lazy\" src=\"https://upload.wikimedia.org/wikipedia/commons/f/f9/Salesforce.com_logo.svg\"/>\n                                <img alt=\"Pipedrive\" class=\"h-4\" data-kid=\"2-1-4-1-3-1-2-2-3\" data-name=\"pipedrive logo\" loading=\"lazy\" src=\"https://upload.wikimedia.org/wikipedia/commons/0/07/Pipedrive_logo.svg\"/>\n                            </div>\n                        </div>\n                    </div>\n                    <!-- Aira API -->\n                    <div class=\"bg-white rounded-3xl p-16 flex flex-col justify-between min-h-[500px] border border-black/5\" data-kid=\"2-1-4-1-3-2\" data-name=\"api card\">\n                        <div data-kid=\"2-1-4-1-3-2-1\" data-name=\"card content area\">\n                            <div class=\"flex items-center gap-3 mb-10\" data-kid=\"2-1-4-1-3-2-1-1\" data-name=\"card label\">\n                                <span class=\"w-2 h-2 rounded-full bg-blue-500\" data-kid=\"2-1-4-1-3-2-1-1-1\" data-name=\"label dot\">\n                                </span>\n                                <span class=\"text-gray-400 text-[10px] font-mono\" data-kid=\"2-1-4-1-3-2-1-1-2\" data-name=\"label text\">\n                                    Aira API | DEVELOPER ACCESS\n                                </span>\n                            </div>\n                            <h4 class=\"font-serif text-4xl mb-8\" data-kid=\"2-1-4-1-3-2-1-2\" data-name=\"card title\">\n                                Pull verified company data into your own systems.\n                            </h4>\n                            <!-- JSON Mockup -->\n                            <div class=\"bg-[#080808] rounded-2xl p-8 font-mono text-[13px] leading-relaxed overflow-hidden relative border border-white/5 shadow-2xl\" data-kid=\"2-1-4-1-3-2-1-3\" data-name=\"json code mockup\">\n                                <div class=\"absolute top-4 right-4 flex gap-1.5\" data-kid=\"2-1-4-1-3-2-1-3-1\" data-name=\"mockup window controls\">\n                                    <span class=\"w-2 h-2 rounded-full bg-red-500/50\" data-kid=\"2-1-4-1-3-2-1-3-1-1\" data-name=\"close control\">\n                                    </span>\n                                    <span class=\"w-2 h-2 rounded-full bg-yellow-500/50\" data-kid=\"2-1-4-1-3-2-1-3-1-2\" data-name=\"minimize control\">\n                                    </span>\n                                    <span class=\"w-2 h-2 rounded-full bg-green-500/50\" data-kid=\"2-1-4-1-3-2-1-3-1-3\" data-name=\"maximize control\">\n                                    </span>\n                                </div>\n                                <div class=\"text-white/30 mb-6 flex justify-between items-center border-b border-white/10 pb-4\" data-kid=\"2-1-4-1-3-2-1-3-2\" data-name=\"mockup header\">\n                                    <span class=\"text-[11px]\" data-kid=\"2-1-4-1-3-2-1-3-2-1\" data-name=\"request method\">\n                                        <span class=\"text-blue-400\" data-kid=\"2-1-4-1-3-2-1-3-2-1-1\" data-name=\"method get\">\n                                            GET\n                                        </span>\n                                        /v1/companies/\n                                        <span class=\"text-green-400\" data-kid=\"2-1-4-1-3-2-1-3-2-1-2\" data-name=\"endpoint id\">\n                                            {id}\n                                        </span>\n                                    </span>\n                                    <span class=\"text-green-400 text-[10px] bg-green-400/10 px-2 py-0.5 rounded\" data-kid=\"2-1-4-1-3-2-1-3-2-2\" data-name=\"response status\">\n                                        200 OK\n                                    </span>\n                                </div>\n                                <div class=\"space-y-1\" data-kid=\"2-1-4-1-3-2-1-3-3\" data-name=\"mockup json content\">\n                                    <div class=\"text-white/60\" data-kid=\"2-1-4-1-3-2-1-3-3-1\" data-name=\"json brace open\">\n                                        {\n                                    </div>\n                                    <div class=\"pl-5\" data-kid=\"2-1-4-1-3-2-1-3-3-2\" data-name=\"json name field\">\n                                        <span class=\"text-blue-300\" data-kid=\"2-1-4-1-3-2-1-3-3-2-1\" data-name=\"json name key\">\n                                            \"name\"\n                                        </span>\n                                        :\n                                        <span class=\"text-green-200\" data-kid=\"2-1-4-1-3-2-1-3-3-2-2\" data-name=\"json name value\">\n                                            \"Meridian Group\"\n                                        </span>\n                                        ,\n                                    </div>\n                                    <div class=\"pl-5\" data-kid=\"2-1-4-1-3-2-1-3-3-3\" data-name=\"json revenue field\">\n                                        <span class=\"text-blue-300\" data-kid=\"2-1-4-1-3-2-1-3-3-3-1\" data-name=\"json revenue key\">\n                                            \"revenue\"\n                                        </span>\n                                        :\n                                        <span class=\"text-green-200\" data-kid=\"2-1-4-1-3-2-1-3-3-3-2\" data-name=\"json revenue value\">\n                                            \"€312M\"\n                                        </span>\n                                        ,\n                                    </div>\n                                    <div class=\"pl-5\" data-kid=\"2-1-4-1-3-2-1-3-3-4\" data-name=\"json ebit field\">\n                                        <span class=\"text-blue-300\" data-kid=\"2-1-4-1-3-2-1-3-3-4-1\" data-name=\"json ebit key\">\n                                            \"ebit_margin\"\n                                        </span>\n                                        :\n                                        <span class=\"text-green-200\" data-kid=\"2-1-4-1-3-2-1-3-3-4-2\" data-name=\"json ebit value\">\n                                            \"18.4%\"\n                                        </span>\n                                        ,\n                                    </div>\n                                    <div class=\"pl-5\" data-kid=\"2-1-4-1-3-2-1-3-3-5\" data-name=\"json signals field\">\n                                        <span class=\"text-blue-300\" data-kid=\"2-1-4-1-3-2-1-3-3-5-1\" data-name=\"json signals key\">\n                                            \"signals\"\n                                        </span>\n                                        :\n                                        <span class=\"text-green-200\" data-kid=\"2-1-4-1-3-2-1-3-3-5-2\" data-name=\"json signals value\">\n                                            \"Recent IPO\"\n                                        </span>\n                                        ,\n                                    </div>\n                                    <div class=\"pl-5\" data-kid=\"2-1-4-1-3-2-1-3-3-6\" data-name=\"json status field\">\n                                        <span class=\"text-blue-300\" data-kid=\"2-1-4-1-3-2-1-3-3-6-1\" data-name=\"json status key\">\n                                            \"status\"\n                                        </span>\n                                        :\n                                        <span class=\"text-green-200\" data-kid=\"2-1-4-1-3-2-1-3-3-6-2\" data-name=\"json status value\">\n                                            \"verified\"\n                                        </span>\n                                    </div>\n                                    <div class=\"text-white/60\" data-kid=\"2-1-4-1-3-2-1-3-3-7\" data-name=\"json brace close\">\n                                        }\n                                    </div>\n                                </div>\n                            </div>\n                        </div>\n                        <a class=\"btn-pill-dark w-fit mt-12 px-8\" data-kid=\"2-1-4-1-3-2-2\" data-name=\"talk to sales button\" href=\"#\">\n                            Talk to sales\n                        </a>\n                    </div>\n                </div>\n            </div>\n        </section>\n        <!-- Dark Database Section -->\n        <section class=\"w-full bg-[#080808] py-56 px-10 relative overflow-hidden\" data-kid=\"2-1-5\" data-name=\"database section\">\n            <!-- Background Earth -->\n            <img class=\"absolute inset-0 w-full h-full object-cover opacity-20 scale-125\" data-kid=\"2-1-5-1\" data-name=\"earth background image\" decoding=\"async\" id=\"database-bg-img\" loading=\"lazy\" src=\"https://cdn.prod.website-files.com/68513e75563291f5d48ada9b/696df7aeb646a7a2198327de_36fa0c4d18a844367e1911df246f6613_earth.webp?auto=format&w=2000&q=80&fit=crop\"/>\n            <div class=\"relative z-10 max-w-7xl mx-auto text-center\" data-kid=\"2-1-5-2\" data-name=\"section content\">\n                <h2 class=\"font-serif text-[4.5rem] text-white leading-[1.1] mb-10 reveal-up\" data-kid=\"2-1-5-2-1\" data-name=\"section headline\">\n                    Access the largest European B2B database.\n                </h2>\n                <p class=\"text-white/60 text-2xl max-w-2xl mx-auto mb-16 reveal-up\" data-kid=\"2-1-5-2-2\" data-name=\"section description\">\n                    Aira connects the dots and surfaces opportunity and risk on every company you track.\n                </p>\n                <div class=\"flex justify-center gap-6 mb-24 reveal-up\" data-kid=\"2-1-5-2-3\" data-name=\"cta buttons container\">\n                    <a class=\"btn-pill-light px-10 py-4 text-base\" data-kid=\"2-1-5-2-3-1\" data-name=\"book a demo button\" href=\"#\">\n                        Book a demo\n                    </a>\n                    <a class=\"btn-pill-outline px-10 py-4 text-base hover:bg-white/10 transition-colors\" data-kid=\"2-1-5-2-3-2\" data-name=\"hubspot integration button\" href=\"#\">\n                        HubSpot integration\n                    </a>\n                </div>\n                <!-- Metrics -->\n                <div class=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-16 text-left border-t border-white/10 pt-24 reveal-up\" data-kid=\"2-1-5-2-4\" data-name=\"metrics grid\">\n                    <div class=\"metric-item\" data-kid=\"2-1-5-2-4-1\" data-name=\"metric item\">\n                        <div class=\"text-[5rem] text-white font-light mb-6 tracking-tighter counter-val\" data-dynamic=\"true\" data-kid=\"2-1-5-2-4-1-1\" data-name=\"metric counter value\" data-reason=\"number incremented by script\" data-target=\"65\">\n                            65M\n                        </div>\n                        <p class=\"text-white/50 text-base leading-relaxed max-w-[240px]\" data-kid=\"2-1-5-2-4-1-2\" data-name=\"metric label\">\n                            Companies with financials, contact information, and ownership data\n                        </p>\n                    </div>\n                    <div class=\"metric-item\" data-kid=\"2-1-5-2-4-2\" data-name=\"metric item\">\n                        <div class=\"text-[5rem] text-white font-light mb-6 tracking-tighter counter-val\" data-dynamic=\"true\" data-kid=\"2-1-5-2-4-2-1\" data-name=\"metric counter value\" data-reason=\"number incremented by script\" data-target=\"14\">\n                            14\n                        </div>\n                        <p class=\"text-white/50 text-base leading-relaxed max-w-[240px]\" data-kid=\"2-1-5-2-4-2-2\" data-name=\"metric label\">\n                            European markets covered\n                        </p>\n                    </div>\n                    <div class=\"metric-item\" data-kid=\"2-1-5-2-4-3\" data-name=\"metric item\">\n                        <div class=\"text-[5rem] text-white font-light mb-6 tracking-tighter counter-val\" data-dynamic=\"true\" data-kid=\"2-1-5-2-4-3-1\" data-name=\"metric counter value\" data-reason=\"number incremented by script\" data-target=\"24\">\n                            24/7\n                        </div>\n                        <p class=\"text-white/50 text-base leading-relaxed max-w-[240px]\" data-kid=\"2-1-5-2-4-3-2\" data-name=\"metric label\">\n                            Financial and news monitoring of the companies you track\n                        </p>\n                    </div>\n                    <div class=\"metric-item\" data-kid=\"2-1-5-2-4-4\" data-name=\"metric item\">\n                        <div class=\"text-[5rem] text-white font-light mb-6 tracking-tighter counter-val\" data-dynamic=\"true\" data-kid=\"2-1-5-2-4-4-1\" data-name=\"metric counter value\" data-reason=\"number incremented by script\" data-target=\"3\">\n                            3M\n                        </div>\n                        <p class=\"text-white/50 text-base leading-relaxed max-w-[240px]\" data-kid=\"2-1-5-2-4-4-2\" data-name=\"metric label\">\n                            News articles scanned daily to surface opportunity and risk\n                        </p>\n                    </div>\n                </div>\n            </div>\n        </section>\n        <!-- Pinned Feature Rows (Dark) -->\n        <section class=\"w-full bg-[#080808]\" data-kid=\"2-1-6\" data-name=\"feature pin container\" id=\"features-pin-container\">\n            <!-- Feature 01 -->\n            <div class=\"feature-row-pinned px-10 border-b border-white/5\" data-kid=\"2-1-6-1\" data-name=\"pinned feature row 1\">\n                <div class=\"max-w-7xl mx-auto flex flex-col lg:flex-row gap-24 items-center w-full\" data-kid=\"2-1-6-1-1\" data-name=\"feature content\">\n                    <div class=\"lg:w-1/2 py-20\" data-kid=\"2-1-6-1-1-1\" data-name=\"feature text side\">\n                        <span class=\"text-white/40 text-[10px] font-mono mb-10 block\" data-kid=\"2-1-6-1-1-1-1\" data-name=\"feature index\">\n                            01\n                        </span>\n                        <h3 class=\"font-serif text-6xl text-white mb-10 leading-[1.1]\" data-kid=\"2-1-6-1-1-1-2\" data-name=\"feature title\">\n                            \"Find more companies like our best customers\"\n                        </h3>\n                        <p class=\"text-white/60 text-2xl leading-relaxed mb-10\" data-kid=\"2-1-6-1-1-1-3\" data-name=\"feature description 1\">\n                            Aira doesn't just match on size and revenue. It reads company websites to understand what each company actually does, tracks the news for the right moment to approach them, and surfaces the contacts and customers you already share.\n                        </p>\n                        <p class=\"text-white/40 text-lg mb-12\" data-kid=\"2-1-6-1-1-1-4\" data-name=\"feature description 2\">\n                            The result is a shortlist of companies most likely to become your next customer, from a database of 65 million companies across 14 markets.\n                        </p>\n                        <a class=\"btn-pill-light w-fit px-10 py-4 text-base\" data-kid=\"2-1-6-1-1-1-5\" data-name=\"book a demo button\" href=\"#\">\n                            Book a demo\n                        </a>\n                    </div>\n                    <div class=\"lg:w-1/2 relative rounded-[2.5rem] overflow-hidden aspect-[4/3] bg-neutral-900\" data-kid=\"2-1-6-1-1-2\" data-name=\"feature visual side\">\n                        <img alt=\"Feature 1\" class=\"w-full h-full object-cover opacity-90\" data-kid=\"2-1-6-1-1-2-1\" data-name=\"feature image\" decoding=\"async\" loading=\"lazy\" src=\"https://cdn.prod.website-files.com/68513e75563291f5d48ada9b/69ef4da6d488608284e34ede_858d93c661e2f6af533ebbe230222d4e_desktop%20for%20website%2065-p-2000.webp?auto=format&w=1200&q=80&fit=crop\"/>\n                    </div>\n                </div>\n            </div>\n            <!-- Feature 02 -->\n            <div class=\"feature-row-pinned px-10 border-b border-white/5\" data-kid=\"2-1-6-2\" data-name=\"pinned feature row 2\">\n                <div class=\"max-w-7xl mx-auto flex flex-col lg:flex-row gap-24 items-center w-full\" data-kid=\"2-1-6-2-1\" data-name=\"feature content\">\n                    <div class=\"lg:w-1/2 order-2 lg:order-1 relative rounded-[2.5rem] overflow-hidden aspect-[4/3] bg-neutral-900\" data-kid=\"2-1-6-2-1-1\" data-name=\"feature visual side\">\n                        <img alt=\"Feature 2\" class=\"w-full h-full object-cover opacity-90\" data-kid=\"2-1-6-2-1-1-1\" data-name=\"feature image\" decoding=\"async\" loading=\"lazy\" src=\"https://cdn.prod.website-files.com/68513e75563291f5d48ada9b/69ef77225f05ad01f9c92a35_3fa0d38e29910547442d7fde55b88d08_opportunity%20and%20risk-p-2000.webp?auto=format&w=1200&q=80&fit=crop\"/>\n                    </div>\n                    <div class=\"lg:w-1/2 order-1 lg:order-2 py-20\" data-kid=\"2-1-6-2-1-2\" data-name=\"feature text side\">\n                        <span class=\"text-white/40 text-[10px] font-mono mb-10 block\" data-kid=\"2-1-6-2-1-2-1\" data-name=\"feature index\">\n                            02\n                        </span>\n                        <h3 class=\"font-serif text-6xl text-white mb-10 leading-[1.1]\" data-kid=\"2-1-6-2-1-2-2\" data-name=\"feature title\">\n                            Know the moment a customer is ready to buy more, or is at risk\n                        </h3>\n                        <p class=\"text-white/60 text-2xl leading-relaxed mb-12\" data-kid=\"2-1-6-2-1-2-3\" data-name=\"feature description\">\n                            Aira monitors the news and financials of every company you work with, so you catch the moment one of them is on the rise, or in decline, and act before anyone else.\n                        </p>\n                        <a class=\"btn-pill-light w-fit px-10 py-4 text-base\" data-kid=\"2-1-6-2-1-2-4\" data-name=\"book a demo button\" href=\"#\">\n                            Book a demo\n                        </a>\n                    </div>\n                </div>\n            </div>\n        </section>\n        <!-- News Section -->\n        <section class=\"w-full bg-[#f9f8f6] py-40 px-10\" data-kid=\"2-1-7\" data-name=\"news section\">\n            <div class=\"max-w-7xl mx-auto\" data-kid=\"2-1-7-1\" data-name=\"news container\">\n                <div class=\"flex flex-col md:flex-row justify-between items-start md:items-end mb-24 gap-8\" data-kid=\"2-1-7-1-1\" data-name=\"header area\">\n                    <div data-kid=\"2-1-7-1-1-1\" data-name=\"title area\">\n                        <div class=\"flex items-center gap-2 mb-8\" data-kid=\"2-1-7-1-1-1-1\" data-name=\"label area\">\n                            <span class=\"font-mono text-gray-400\" data-kid=\"2-1-7-1-1-1-1-1\" data-name=\"news label\">\n                                News\n                            </span>\n                        </div>\n                        <h2 class=\"font-serif text-[4.5rem] text-[#1c1d1f]\" data-kid=\"2-1-7-1-1-1-2\" data-name=\"section title\">\n                            The latest news from Aira\n                        </h2>\n                    </div>\n                    <a class=\"text-[#70706f] hover:text-black font-sans text-lg flex items-center gap-2 mb-2 group\" data-kid=\"2-1-7-1-1-2\" data-name=\"all news link\" href=\"#\">\n                        All news\n                        <span class=\"group-hover:translate-x-1 transition-transform\" data-kid=\"2-1-7-1-1-2-1\" data-name=\"arrow icon\">\n                            →\n                        </span>\n                    </a>\n                </div>\n                <div class=\"grid grid-cols-1 md:grid-cols-3 gap-12\" data-kid=\"2-1-7-1-2\" data-name=\"news card grid\">\n                    <!-- Card 1 -->\n                    <a class=\"group block\" data-kid=\"2-1-7-1-2-1\" data-name=\"news card 1\" href=\"#\">\n                        <div class=\"rounded-2xl overflow-hidden mb-10 aspect-[16/10] bg-gray-200\" data-kid=\"2-1-7-1-2-1-1\" data-name=\"card image wrapper\">\n                            <img class=\"w-full h-full object-cover group-hover:scale-105 transition-transform duration-500\" data-kid=\"2-1-7-1-2-1-1-1\" data-name=\"card image\" decoding=\"async\" loading=\"lazy\" src=\"https://cdn.prod.website-files.com/68513e75563291f5d48ada9b/6a438c02ba258546c56bb2a9_hubspot%20aira%20integration.webp?auto=format&w=800&q=80&fit=crop\"/>\n                        </div>\n                        <h3 class=\"font-serif text-[1.75rem] mb-6 leading-[1.2] group-hover:underline decoration-1 underline-offset-8\" data-kid=\"2-1-7-1-2-1-2\" data-name=\"card title\">\n                            Aira launches Aira Connect, a native HubSpot integration\n                        </h3>\n                        <p class=\"text-[#70706f] text-base leading-relaxed mb-8\" data-kid=\"2-1-7-1-2-1-3\" data-name=\"card description\">\n                            Aira has launched Aira Connect, a native integration that enriches HubSpot with licensed financial data and buying signals on more than 65 million European companies.\n                        </p>\n                        <span class=\"text-xs font-semibold text-gray-400 uppercase tracking-widest font-mono group-hover:text-black\" data-kid=\"2-1-7-1-2-1-4\" data-name=\"read more link\">\n                            Read more →\n                        </span>\n                    </a>\n                    <!-- Card 2 -->\n                    <a class=\"group block\" data-kid=\"2-1-7-1-2-2\" data-name=\"news card 2\" href=\"#\">\n                        <div class=\"rounded-2xl overflow-hidden mb-10 aspect-[16/10] bg-gray-200\" data-kid=\"2-1-7-1-2-2-1\" data-name=\"card image wrapper\">\n                            <img class=\"w-full h-full object-cover group-hover:scale-105 transition-transform duration-500\" data-kid=\"2-1-7-1-2-2-1-1\" data-name=\"card image\" decoding=\"async\" loading=\"lazy\" src=\"https://cdn.prod.website-files.com/68513e75563291f5d48ada9b/6a438ca0103bc4d61ac834c3_6a2172cf13ea462e9f3f15e4_Aira_052726-1%20(1).webp?auto=format&w=800&q=80&fit=crop\"/>\n                        </div>\n                        <h3 class=\"font-serif text-[1.75rem] mb-6 leading-[1.2] group-hover:underline decoration-1 underline-offset-8\" data-kid=\"2-1-7-1-2-2-2\" data-name=\"card title\">\n                            Aira is now listed on Nasdaq First North\n                        </h3>\n                        <p class=\"text-[#70706f] text-base leading-relaxed mb-8\" data-kid=\"2-1-7-1-2-2-3\" data-name=\"card description\">\n                            Shares in AI Revenue Assistant Software Stockholm AB began trading on Nasdaq First North Growth Market in Stockholm under the ticker symbol AIRA.\n                        </p>\n                        <span class=\"text-xs font-semibold text-gray-400 uppercase tracking-widest font-mono group-hover:text-black\" data-kid=\"2-1-7-1-2-2-4\" data-name=\"read more link\">\n                            Read more →\n                        </span>\n                    </a>\n                    <!-- Card 3 -->\n                    <a class=\"group block\" data-kid=\"2-1-7-1-2-3\" data-name=\"news card 3\" href=\"#\">\n                        <div class=\"rounded-2xl overflow-hidden mb-10 aspect-[16/10] bg-gray-200\" data-kid=\"2-1-7-1-2-3-1\" data-name=\"card image wrapper\">\n                            <img class=\"w-full h-full object-cover group-hover:scale-105 transition-transform duration-500\" data-kid=\"2-1-7-1-2-3-1-1\" data-name=\"card image\" decoding=\"async\" loading=\"lazy\" src=\"https://cdn.prod.website-files.com/68513e75563291f5d48ada9b/6a438c59f115d45ee5ef8c33_6a310cb0fd4c146a93a977a7_signals%20web%20(1).webp?auto=format&w=800&q=80&fit=crop\"/>\n                        </div>\n                        <h3 class=\"font-serif text-[1.75rem] mb-6 leading-[1.2] group-hover:underline decoration-1 underline-offset-8\" data-kid=\"2-1-7-1-2-3-2\" data-name=\"card title\">\n                            Releasing Signals: monitor the companies you care about\n                        </h3>\n                        <p class=\"text-[#70706f] text-base leading-relaxed mb-8\" data-kid=\"2-1-7-1-2-3-3\" data-name=\"card description\">\n                            Aira now monitors the financials, websites, and news of every company in your Portfolio and surfaces the changes that matter.\n                        </p>\n                        <span class=\"text-xs font-semibold text-gray-400 uppercase tracking-widest font-mono group-hover:text-black\" data-kid=\"2-1-7-1-2-3-4\" data-name=\"read more link\">\n                            Read more →\n                        </span>\n                    </a>\n                </div>\n            </div>\n        </section>\n        <!-- Intelligence Rows (Dark) -->\n        <section class=\"w-full bg-[#080808] px-10\" data-kid=\"2-1-8\" data-name=\"intelligence section\">\n            <div class=\"max-w-7xl mx-auto\" data-kid=\"2-1-8-1\" data-name=\"intelligence rows container\">\n                <!-- Intelligence Row 01 -->\n                <div class=\"intelligence-row py-40 border-b border-white/10 flex flex-col lg:flex-row gap-24 items-center\" data-kid=\"2-1-8-1-1\" data-name=\"row 1\">\n                    <div class=\"lg:w-1/2\" data-kid=\"2-1-8-1-1-1\" data-name=\"row text area\">\n                        <span class=\"text-white/40 text-[10px] font-mono mb-10 block\" data-kid=\"2-1-8-1-1-1-1\" data-name=\"row index\">\n                            01\n                        </span>\n                        <h3 class=\"font-serif text-[3.5rem] text-white mb-10 leading-[1.1]\" data-kid=\"2-1-8-1-1-1-2\" data-name=\"row title\">\n                            News and financial monitoring on every company you track\n                        </h3>\n                        <p class=\"text-white/60 text-lg leading-relaxed mb-10\" data-kid=\"2-1-8-1-1-1-3\" data-name=\"row description 1\">\n                            Aira monitors every company you track, following annual reports, leadership changes, group structure, news, website updates, and hundreds of other signals. The moment something points to an opportunity or a risk, you're notified.\n                        </p>\n                        <p class=\"text-white/30 text-base mb-12 italic\" data-kid=\"2-1-8-1-1-1-4\" data-name=\"row description 2\">\n                            The same intelligence used by top investment banks, in your pocket.\n                        </p>\n                        <a class=\"btn-pill-light w-fit\" data-kid=\"2-1-8-1-1-1-5\" data-name=\"book a demo button\" href=\"#\">\n                            Book a demo\n                        </a>\n                    </div>\n                    <div class=\"lg:w-1/2 relative rounded-[2rem] overflow-hidden aspect-[4/3]\" data-kid=\"2-1-8-1-1-2\" data-name=\"row image area\">\n                        <img alt=\"Intelligence 1\" class=\"w-full h-full object-cover\" data-kid=\"2-1-8-1-1-2-1\" data-name=\"row image\" decoding=\"async\" loading=\"lazy\" src=\"https://cdn.prod.website-files.com/68513e75563291f5d48ada9b/6971177432ff087027915fc9_f276e7ddc524dfe27b757fb957c8212f_News%20and%20financial%20monitoring%20across%20your%20entire%20portfolio-p-2000.webp?auto=format&w=1200&q=80&fit=crop\"/>\n                    </div>\n                </div>\n                <!-- Intelligence Row 02 -->\n                <div class=\"intelligence-row py-40 border-b border-white/10 flex flex-col lg:flex-row gap-24 items-center\" data-kid=\"2-1-8-1-2\" data-name=\"row 2\">\n                    <div class=\"lg:w-1/2 order-2 lg:order-1 relative rounded-[2rem] overflow-hidden aspect-[4/3]\" data-kid=\"2-1-8-1-2-1\" data-name=\"row image area\">\n                        <img alt=\"Intelligence 2\" class=\"w-full h-full object-cover\" data-kid=\"2-1-8-1-2-1-1\" data-name=\"row image\" decoding=\"async\" loading=\"lazy\" src=\"https://cdn.prod.website-files.com/68513e75563291f5d48ada9b/69f0c2b191c0b784171a069a_689158af5523883fdeb2e16b48aa4cb6_Deep%20research-p-2000.webp?auto=format&w=1200&q=80&fit=crop\"/>\n                    </div>\n                    <div class=\"lg:w-1/2 order-1 lg:order-2\" data-kid=\"2-1-8-1-2-2\" data-name=\"row text area\">\n                        <span class=\"text-white/40 text-[10px] font-mono mb-10 block\" data-kid=\"2-1-8-1-2-2-1\" data-name=\"row index\">\n                            02\n                        </span>\n                        <h3 class=\"font-serif text-[3.5rem] text-white mb-10 leading-[1.1]\" data-kid=\"2-1-8-1-2-2-2\" data-name=\"row title\">\n                            Deep research on any company, on demand.\n                        </h3>\n                        <p class=\"text-white/60 text-lg leading-relaxed mb-12\" data-kid=\"2-1-8-1-2-2-3\" data-name=\"row description\">\n                            Tell Aira what you need to know. It searches financial databases, news sources, your email history, previous meetings, and the internet — then comes back with exactly what you asked for.\n                        </p>\n                        <a class=\"btn-pill-light w-fit\" data-kid=\"2-1-8-1-2-2-4\" data-name=\"book a demo button\" href=\"#\">\n                            Book a demo\n                        </a>\n                    </div>\n                </div>\n                <!-- Intelligence Row 03 -->\n                <div class=\"intelligence-row py-40 flex flex-col lg:flex-row gap-24 items-center\" data-kid=\"2-1-8-1-3\" data-name=\"row 3\">\n                    <div class=\"lg:w-1/2\" data-kid=\"2-1-8-1-3-1\" data-name=\"row text area\">\n                        <span class=\"text-white/40 text-[10px] font-mono mb-10 block\" data-kid=\"2-1-8-1-3-1-1\" data-name=\"row index\">\n                            03\n                        </span>\n                        <h3 class=\"font-serif text-[3.5rem] text-white mb-10 leading-[1.1]\" data-kid=\"2-1-8-1-3-1-2\" data-name=\"row title\">\n                            You can’t keep track of it all. Aira can.\n                        </h3>\n                        <p class=\"text-white/60 text-lg leading-relaxed mb-10\" data-kid=\"2-1-8-1-3-1-3\" data-name=\"row description 1\">\n                            Aira tracks every conversation, joins your calls, and takes your notes. Every account is enriched with financials, contacts, news, board changes, and filings from 65 million companies.\n                        </p>\n                        <p class=\"text-white/30 text-base mb-12\" data-kid=\"2-1-8-1-3-1-4\" data-name=\"row description 2\">\n                            So you can focus on revenue, not admin.\n                        </p>\n                        <a class=\"btn-pill-light w-fit\" data-kid=\"2-1-8-1-3-1-5\" data-name=\"book a demo button\" href=\"#\">\n                            Book a demo\n                        </a>\n                    </div>\n                    <div class=\"lg:w-1/2 relative rounded-[2rem] overflow-hidden aspect-[4/3]\" data-kid=\"2-1-8-1-3-2\" data-name=\"row image area\">\n                        <img alt=\"Intelligence 3\" class=\"w-full h-full object-cover\" data-kid=\"2-1-8-1-3-2-1\" data-name=\"row image\" decoding=\"async\" loading=\"lazy\" src=\"https://cdn.prod.website-files.com/68513e75563291f5d48ada9b/6970c8fca3eba219d35aad0d_676c6e25b38e2f972faf879f137f2ccf_You%20can%27t%20keep%20track%20of%20it%20all.%20Aira%20can.-p-2000.webp?auto=format&w=1200&q=80&fit=crop\"/>\n                    </div>\n                </div>\n            </div>\n        </section>\n        <!-- Chat Showcase -->\n        <section class=\"w-full bg-[#080808] py-40 px-10\" data-kid=\"2-1-9\" data-name=\"chat showcase section\">\n            <div class=\"max-w-6xl mx-auto rounded-[3rem] overflow-hidden bg-white/5 border border-white/10 aspect-video relative group shado