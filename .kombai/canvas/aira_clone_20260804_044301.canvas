0l5-5m11 5l-5-5m5 5v-4m0 4h-4\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\">\n                                    </path>\n                                </svg>\n                            </div>\n                        </div>\n                        <div class=\"flex-1 p-12 overflow-y-auto bg-gradient-to-b from-white to-[#f0efed]\" data-kid=\"2-1-9-1-1-1-2\" data-name=\"chat history area\">\n                            <div class=\"max-w-2xl mx-auto space-y-8\" data-kid=\"2-1-9-1-1-1-2-1\" data-name=\"chat thread\">\n                                <div class=\"flex flex-col items-end\" data-kid=\"2-1-9-1-1-1-2-1-1\" data-name=\"user message\">\n                                    <div class=\"bg-white border border-black/5 p-5 rounded-3xl rounded-br-none text-sm text-gray-700 shadow-sm max-w-lg\" data-kid=\"2-1-9-1-1-1-2-1-1-1\" data-name=\"user message bubble\">\n                                        Give me an overview of recent changes at Nexen Capital?\n                                    </div>\n                                </div>\n                                <div class=\"flex gap-4\" data-kid=\"2-1-9-1-1-1-2-1-2\" data-name=\"ai message\">\n                                    <div class=\"w-8 h-8 rounded-full bg-black flex items-center justify-center shrink-0 mt-1\" data-kid=\"2-1-9-1-1-1-2-1-2-1\" data-name=\"ai avatar\">\n                                        <svg class=\"w-4 h-4 text-white\" data-kid=\"2-1-9-1-1-1-2-1-2-1-1\" data-name=\"ai avatar icon\" fill=\"currentColor\" viewbox=\"0 0 24 24\">\n                                            <path d=\"M12 2L13.8 8.8L20.8 10.6L14 12.4L12.2 19.2L10.4 12.4L3.6 10.6L10.6 8.8L12 2Z\">\n                                            </path>\n                                        </svg>\n                                    </div>\n                                    <div class=\"bg-[#080808] text-white p-8 rounded-[2rem] rounded-tl-none text-sm leading-relaxed shadow-xl border border-white/5\" data-kid=\"2-1-9-1-1-1-2-1-2-2\" data-name=\"ai message bubble\">\n                                        <p class=\"text-white/90 mb-4 font-serif text-lg\" data-kid=\"2-1-9-1-1-1-2-1-2-2-1\" data-name=\"ai message title\">\n                                            Nexen Capital has seen significant activity in the last 72 hours:\n                                        </p>\n                                        <ul class=\"space-y-4 text-white/70\" data-kid=\"2-1-9-1-1-1-2-1-2-2-2\" data-name=\"ai list items\">\n                                            <li class=\"flex items-start gap-3\" data-kid=\"2-1-9-1-1-1-2-1-2-2-2-1\" data-name=\"list item 1\">\n                                                <span class=\"w-1.5 h-1.5 rounded-full bg-red-400 mt-2 shrink-0\" data-kid=\"2-1-9-1-1-1-2-1-2-2-2-1-1\" data-name=\"list marker\">\n                                                </span>\n                                                <span data-kid=\"2-1-9-1-1-1-2-1-2-2-2-1-2\" data-name=\"list text\">\n                                                    Founder reduced equity stake from 45% to 28% in recent filing.\n                                                </span>\n                                            </li>\n                                            <li class=\"flex items-start gap-3\" data-kid=\"2-1-9-1-1-1-2-1-2-2-2-2\" data-name=\"list item 2\">\n                                                <span class=\"w-1.5 h-1.5 rounded-full bg-green-400 mt-2 shrink-0\" data-kid=\"2-1-9-1-1-1-2-1-2-2-2-2-1\" data-name=\"list marker\">\n                                                </span>\n                                                <span data-kid=\"2-1-9-1-1-1-2-1-2-2-2-2-2\" data-name=\"list text\">\n                                                    New registration for 'Nexen Venture' in Amsterdam identified via trade register.\n                                                </span>\n                                            </li>\n                                            <li class=\"flex items-start gap-3\" data-kid=\"2-1-9-1-1-1-2-1-2-2-2-3\" data-name=\"list item 3\">\n                                                <span class=\"w-1.5 h-1.5 rounded-full bg-yellow-400 mt-2 shrink-0\" data-kid=\"2-1-9-1-1-1-2-1-2-2-2-3-1\" data-name=\"list marker\">\n                                                </span>\n                                                <span data-kid=\"2-1-9-1-1-1-2-1-2-2-2-3-2\" data-name=\"list text\">\n                                                    Revenue reports show a 12% dip in Q3 logistics vertical; majority owner reducing exposure.\n                                                </span>\n                                            </li>\n                                        </ul>\n                                    </div>\n                                </div>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </section>\n        <!-- Event Collage -->\n        <section class=\"w-full bg-[#080808] py-40 px-10 border-t border-white/5\" data-kid=\"2-1-10\" data-name=\"event collage section\">\n            <div class=\"max-w-7xl mx-auto\" data-kid=\"2-1-10-1\" data-name=\"section container\">\n                <div class=\"grid grid-cols-2 md:grid-cols-4 gap-6 auto-rows-[350px]\" data-kid=\"2-1-10-1-1\" data-name=\"events grid\">\n                    <!-- Event 1 -->\n                    <div class=\"relative group rounded-3xl overflow-hidden md:col-span-2 border border-white/10 shadow-xl\" data-kid=\"2-1-10-1-1-1\" data-name=\"event image card 1\">\n                        <img alt=\"Dubai Yacht\" class=\"w-full h-full object-cover opacity-70 group-hover:opacity-100 transition-opacity duration-500\" data-kid=\"2-1-10-1-1-1-1\" data-name=\"event image\" decoding=\"async\" loading=\"lazy\" src=\"https://cdn.prod.website-files.com/68513e75563291f5d48ada9b/6981ffe3f2ce2f6e43599171_va%CC%88lj%201.avif\"/>\n                        <div class=\"absolute top-6 left-6 px-5 py-2.5 rounded-full bg-black/40 backdrop-blur-xl border border-white/10 text-white text-[10px] font-mono uppercase tracking-widest font-semibold\" data-kid=\"2-1-10-1-1-1-2\" data-name=\"event label\">\n                            Dubai Yacht Event\n                        </div>\n                    </div>\n                    <!-- Event 2 -->\n                    <div class=\"relative group rounded-3xl overflow-hidden border border-white/10 shadow-xl\" data-kid=\"2-1-10-1-1-2\" data-name=\"event image card 2\">\n                        <img alt=\"Paris\" class=\"w-full h-full object-cover opacity-70 group-hover:opacity-100 transition-opacity duration-500\" data-kid=\"2-1-10-1-1-2-1\" data-name=\"event image\" decoding=\"async\" loading=\"lazy\" src=\"https://cdn.prod.website-files.com/68513e75563291f5d48ada9b/69de328a186bd44416b25972_KAT_0060_Denoised.jpg\"/>\n                        <div class=\"absolute top-6 left-6 px-5 py-2.5 rounded-full bg-black/40 backdrop-blur-xl border border-white/10 text-white text-[10px] font-mono uppercase tracking-widest font-semibold\" data-kid=\"2-1-10-1-1-2-2\" data-name=\"event label\">\n                            Hôtel Particulier, Paris\n                        </div>\n                    </div>\n                    <!-- Event 3 -->\n                    <div class=\"relative group rounded-3xl overflow-hidden border border-white/10 shadow-xl\" data-kid=\"2-1-10-1-1-3\" data-name=\"event image card 3\">\n                        <img alt=\"Summit\" class=\"w-full h-full object-cover opacity-70 group-hover:opacity-100 transition-opacity duration-500\" data-kid=\"2-1-10-1-1-3-1\" data-name=\"event image\" decoding=\"async\" loading=\"lazy\" src=\"https://cdn.prod.website-files.com/68513e75563291f5d48ada9b/6981ffeb3f8412a6f48f5088_KAT_0177_Denoised%201.avif\"/>\n                        <div class=\"absolute top-6 left-6 px-5 py-2.5 rounded-full bg-black/40 backdrop-blur-xl border border-white/10 text-white text-[10px] font-mono uppercase tracking-widest font-semibold\" data-kid=\"2-1-10-1-1-3-2\" data-name=\"event label\">\n                            Executive Summit\n                        </div>\n                    </div>\n                    <!-- Event 4 -->\n                    <div class=\"relative group rounded-3xl overflow-hidden border border-white/10 shadow-xl\" data-kid=\"2-1-10-1-1-4\" data-name=\"event image card 4\">\n                        <img alt=\"CEO Roundtable\" class=\"w-full h-full object-cover opacity-70 group-hover:opacity-100 transition-opacity duration-500\" data-kid=\"2-1-10-1-1-4-1\" data-name=\"event image\" decoding=\"async\" loading=\"lazy\" src=\"https://cdn.prod.website-files.com/68513e75563291f5d48ada9b/696f9ec7ca3c8b12d4d5c723_national.avif\"/>\n                        <div class=\"absolute top-6 left-6 px-5 py-2.5 rounded-full bg-black/40 backdrop-blur-xl border border-white/10 text-white text-[10px] font-mono uppercase tracking-widest font-semibold\" data-kid=\"2-1-10-1-1-4-2\" data-name=\"event label\">\n                            CEO Roundtable\n                        </div>\n                    </div>\n                    <!-- Event 5 -->\n                    <div class=\"relative group rounded-3xl overflow-hidden md:col-span-2 md:row-span-2 border border-white/10 shadow-xl\" data-kid=\"2-1-10-1-1-5\" data-name=\"event image card 5\">\n                        <img alt=\"Amsterdam\" class=\"w-full h-full object-cover opacity-70 group-hover:opacity-100 transition-opacity duration-500\" data-kid=\"2-1-10-1-1-5-1\" data-name=\"event image\" decoding=\"async\" loading=\"lazy\" src=\"https://cdn.prod.website-files.com/68513e75563291f5d48ada9b/69de328967f038bf0600bf09_Aira_Amsterdam_2026-50.jpg\"/>\n                        <div class=\"absolute top-6 left-6 px-5 py-2.5 rounded-full bg-black/40 backdrop-blur-xl border border-white/10 text-white text-[10px] font-mono uppercase tracking-widest font-semibold\" data-kid=\"2-1-10-1-1-5-2\" data-name=\"event label\">\n                            Amsterdam\n                        </div>\n                    </div>\n                    <!-- Event 6 -->\n                    <div class=\"relative group rounded-3xl overflow-hidden border border-white/10 shadow-xl\" data-kid=\"2-1-10-1-1-6\" data-name=\"event image card 6\">\n                        <img alt=\"Event 6\" class=\"w-full h-full object-cover opacity-70 group-hover:opacity-100 transition-opacity duration-500\" data-kid=\"2-1-10-1-1-6-1\" data-name=\"event image\" decoding=\"async\" loading=\"lazy\" src=\"https://cdn.prod.website-files.com/68513e75563291f5d48ada9b/696f9c422851badf1feb0b0f_DSC_8390-22.avif\"/>\n                    </div>\n                    <!-- Event 7 -->\n                    <div class=\"relative group rounded-3xl overflow-hidden border border-white/10 shadow-xl\" data-kid=\"2-1-10-1-1-7\" data-name=\"event image card 7\">\n                        <img alt=\"Event 7\" class=\"w-full h-full object-cover opacity-70 group-hover:opacity-100 transition-opacity duration-500\" data-kid=\"2-1-10-1-1-7-1\" data-name=\"event image\" decoding=\"async\" loading=\"lazy\" src=\"https://cdn.prod.website-files.com/68513e75563291f5d48ada9b/6983525c1572fa25d06e40b8_va%CC%88lj%207%20(1).jpg\"/>\n                    </div>\n                    <!-- Event 8 -->\n                    <div class=\"relative group rounded-3xl overflow-hidden border border-white/10 shadow-xl\" data-kid=\"2-1-10-1-1-8\" data-name=\"event image card 8\">\n                        <img alt=\"Event 8\" class=\"w-full h-full object-cover opacity-70 group-hover:opacity-100 transition-opacity duration-500\" data-kid=\"2-1-10-1-1-8-1\" data-name=\"event image\" decoding=\"async\" loading=\"lazy\" src=\"https://cdn.prod.website-files.com/68513e75563291f5d48ada9b/69830354f94b58f3cb507685_DSC06825.avif\"/>\n                    </div>\n                </div>\n            </div>\n        </section>\n        <!-- Footer -->\n        <footer class=\"w-full bg-[#f9f8f6] py-32 px-10 border-t border-black/5\" data-kid=\"2-1-11\" data-name=\"footer\">\n            <div class=\"max-w-7xl mx-auto\" data-kid=\"2-1-11-1\" data-name=\"footer container\">\n                <div class=\"flex flex-col lg:flex-row justify-between gap-24\" data-kid=\"2-1-11-1-1\" data-name=\"footer flex\">\n                    <div class=\"lg:max-w-sm\" data-kid=\"2-1-11-1-1-1\" data-name=\"brand info\">\n                        <div class=\"flex items-center gap-3 mb-12\" data-kid=\"2-1-11-1-1-1-1\" data-name=\"brand logo area\">\n                            <svg class=\"w-8 h-8 text-black\" data-kid=\"2-1-11-1-1-1-1-1\" data-name=\"brand logo icon\" fill=\"currentColor\" viewbox=\"0 0 24 24\">\n                                <path d=\"M12 2L13.8 8.8L20.8 10.6L14 12.4L12.2 19.2L10.4 12.4L3.6 10.6L10.6 8.8L12 2Z\">\n                                </path>\n                            </svg>\n                            <span class=\"text-3xl font-semibold tracking-tight\" data-kid=\"2-1-11-1-1-1-1-2\" data-name=\"brand name\">\n                                Aira\n                            </span>\n                        </div>\n                        <p class=\"text-[#70706f] text-sm leading-relaxed\" data-kid=\"2-1-11-1-1-1-2\" data-name=\"copyright info\">\n                            © 2026 Aira. Sveavägen 34, 111 34 Stockholm, Sweden.\n                            <br data-kid=\"2-1-11-1-1-1-2-1\" data-name=\"break tag\"/>\n                            Org.nr: 5595734681\n                        </p>\n                    </div>\n                    <div class=\"grid grid-cols-2 md:grid-cols-4 gap-16 flex-1\" data-kid=\"2-1-11-1-1-2\" data-name=\"footer links\">\n                        <div data-kid=\"2-1-11-1-1-2-1\" data-name=\"link group 1\">\n                            <h5 class=\"text-[10px] font-mono text-gray-400 mb-8\" data-kid=\"2-1-11-1-1-2-1-1\" data-name=\"group title\">\n                                Product\n                            </h5>\n                            <ul class=\"space-y-4\" data-kid=\"2-1-11-1-1-2-1-2\" data-name=\"group list\">\n                                <li data-kid=\"2-1-11-1-1-2-1-2-1\" data-name=\"link item\">\n                                    <a class=\"font-serif text-xl hover:text-gray-500 transition-colors\" data-kid=\"2-1-11-1-1-2-1-2-1-1\" data-name=\"link\" href=\"#\">\n                                        Pricing\n                                    </a>\n                                </li>\n                                <li data-kid=\"2-1-11-1-1-2-1-2-2\" data-name=\"link item\">\n                                    <a class=\"font-serif text-xl hover:text-gray-500 transition-colors\" data-kid=\"2-1-11-1-1-2-1-2-2-1\" data-name=\"link\" href=\"#\">\n                                        HubSpot integration\n                                    </a>\n                                </li>\n                                <li data-kid=\"2-1-11-1-1-2-1-2-3\" data-name=\"link item\">\n                                    <a class=\"font-serif text-xl hover:text-gray-500 transition-colors\" data-kid=\"2-1-11-1-1-2-1-2-3-1\" data-name=\"link\" href=\"#\">\n                                        Book a demo\n                                    </a>\n                                </li>\n                            </ul>\n                        </div>\n                        <div data-kid=\"2-1-11-1-1-2-2\" data-name=\"link group 2\">\n                            <h5 class=\"text-[10px] font-mono text-gray-400 mb-8\" data-kid=\"2-1-11-1-1-2-2-1\" data-name=\"group title\">\n                                Company\n                            </h5>\n                            <ul class=\"space-y-4\" data-kid=\"2-1-11-1-1-2-2-2\" data-name=\"group list\">\n                                <li data-kid=\"2-1-11-1-1-2-2-2-1\" data-name=\"link item\">\n                                    <a class=\"font-serif text-xl hover:text-gray-500 transition-colors\" data-kid=\"2-1-11-1-1-2-2-2-1-1\" data-name=\"link\" href=\"#\">\n                                        About us\n                                    </a>\n                                </li>\n                                <li data-kid=\"2-1-11-1-1-2-2-2-2\" data-name=\"link item\">\n                                    <a class=\"font-serif text-xl hover:text-gray-500 transition-colors\" data-kid=\"2-1-11-1-1-2-2-2-2-1\" data-name=\"link\" href=\"#\">\n                                        News\n                                    </a>\n                                </li>\n                                <li data-kid=\"2-1-11-1-1-2-2-2-3\" data-name=\"link item\">\n                                    <a class=\"font-serif text-xl hover:text-gray-500 transition-colors\" data-kid=\"2-1-11-1-1-2-2-2-3-1\" data-name=\"link\" href=\"#\">\n                                        Revenue journal\n                                    </a>\n                                </li>\n                                <li data-kid=\"2-1-11-1-1-2-2-2-4\" data-name=\"link item\">\n                                    <a class=\"font-serif text-xl hover:text-gray-500 transition-colors\" data-kid=\"2-1-11-1-1-2-2-2-4-1\" data-name=\"link\" href=\"#\">\n                                        Partner program\n                                    </a>\n                                </li>\n                            </ul>\n                        </div>\n                        <div data-kid=\"2-1-11-1-1-2-3\" data-name=\"link group 3\">\n                            <h5 class=\"text-[10px] font-mono text-gray-400 mb-8\" data-kid=\"2-1-11-1-1-2-3-1\" data-name=\"group title\">\n                                Connect\n                            </h5>\n                            <ul class=\"space-y-4\" data-kid=\"2-1-11-1-1-2-3-2\" data-name=\"group list\">\n                                <li data-kid=\"2-1-11-1-1-2-3-2-1\" data-name=\"link item\">\n                                    <a class=\"font-serif text-xl hover:text-gray-500 transition-colors\" data-kid=\"2-1-11-1-1-2-3-2-1-1\" data-name=\"link\" href=\"#\">\n                                        Events\n                                    </a>\n                                </li>\n                                <li data-kid=\"2-1-11-1-1-2-3-2-2\" data-name=\"link item\">\n                                    <a class=\"font-serif text-xl hover:text-gray-500 transition-colors\" data-kid=\"2-1-11-1-1-2-3-2-2-1\" data-name=\"link\" href=\"#\">\n                                        LinkedIn\n                                    </a>\n                                </li>\n                                <li data-kid=\"2-1-11-1-1-2-3-2-3\" data-name=\"link item\">\n                                    <a class=\"font-serif text-xl hover:text-gray-500 transition-colors\" data-kid=\"2-1-11-1-1-2-3-2-3-1\" data-name=\"link\" href=\"#\">\n                                        info@aira.app\n                                    </a>\n                                </li>\n                            </ul>\n                        </div>\n                        <div data-kid=\"2-1-11-1-1-2-4\" data-name=\"link group 4\">\n                            <h5 class=\"text-[10px] font-mono text-gray-400 mb-8\" data-kid=\"2-1-11-1-1-2-4-1\" data-name=\"group title\">\n                                Legal\n                            </h5>\n                            <ul class=\"space-y-4\" data-kid=\"2-1-11-1-1-2-4-2\" data-name=\"group list\">\n                                <li data-kid=\"2-1-11-1-1-2-4-2-1\" data-name=\"link item\">\n                                    <a class=\"font-serif text-xl hover:text-gray-500 transition-colors\" data-kid=\"2-1-11-1-1-2-4-2-1-1\" data-name=\"link\" href=\"#\">\n                                        Terms and conditions\n                                    </a>\n                                </li>\n                                <li data-kid=\"2-1-11-1-1-2-4-2-2\" data-name=\"link item\">\n                                    <a class=\"font-serif text-xl hover:text-gray-500 transition-colors\" data-kid=\"2-1-11-1-1-2-4-2-2-1\" data-name=\"link\" href=\"#\">\n                                        Partner agreement\n                                    </a>\n                                </li>\n                                <li data-kid=\"2-1-11-1-1-2-4-2-3\" data-name=\"link item\">\n                                    <a class=\"font-serif text-xl hover:text-gray-500 transition-colors\" data-kid=\"2-1-11-1-1-2-4-2-3-1\" data-name=\"link\" href=\"#\">\n                                        Privacy policy\n                                    </a>\n                                </li>\n                                <li data-kid=\"2-1-11-1-1-2-4-2-4\" data-name=\"link item\">\n                                    <a class=\"font-serif text-xl hover:text-gray-500 transition-colors\" data-kid=\"2-1-11-1-1-2-4-2-4-1\" data-name=\"link\" href=\"#\">\n                                        DPA\n                                    </a>\n                                </li>\n                                <li data-kid=\"2-1-11-1-1-2-4-2-5\" data-name=\"link item\">\n                                    <a class=\"font-serif text-xl hover:text-gray-500 transition-colors\" data-kid=\"2-1-11-1-1-2-4-2-5-1\" data-name=\"link\" href=\"#\">\n                                        Cookie policy\n                                    </a>\n                                </li>\n                            </ul>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </footer>\n    </div>\n</div>\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/gsap.min.js\">\n</script>\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/ScrollTrigger.min.js\">\n</script>\n<script type=\"module\">\n    import Lenis from \"https://esm.sh/lenis@1\"\n  \n  gsap.registerPlugin(ScrollTrigger);\n\n  // Smooth Scroll\n  const lenis = new Lenis({\n    duration: 1.2,\n    easing: (t) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),\n    smoothWheel: true,\n    orientation: 'vertical',\n    gestureOrientation: 'vertical',\n    wheelMultiplier: 1,\n    smoothTouch: false,\n    touchMultiplier: 2,\n    infinite: false,\n  })\n\n  function raf(time) {\n    lenis.raf(time)\n    requestAnimationFrame(raf)\n  }\n  requestAnimationFrame(raf)\n\n  lenis.on('scroll', ScrollTrigger.update)\n\n  // GSAP Animations\n  // Hero Entrance\n  const heroTl = gsap.timeline();\n  heroTl.from(\"#hero-panel\", {\n    scale: 0.95,\n    borderRadius: \"10rem\",\n    duration: 1.5,\n    ease: \"power4.out\"\n  });\n  heroTl.from(\"#hero-img\", {\n    scale: 1.2,\n    y: 50,\n    duration: 2,\n    ease: \"power3.out\"\n  }, 0);\n\n  // Reveal Lines\n  gsap.utils.toArray('.divider-line, .divider-line-dark').forEach(line => {\n    gsap.from(line, {\n      scaleX: 0,\n      duration: 1.5,\n      ease: \"power4.out\",\n      scrollTrigger: {\n        trigger: line,\n        start: \"top 90%\"\n      }\n    });\n  });\n\n  // Reveal Up elements\n  gsap.utils.toArray('.reveal-up').forEach(el => {\n    gsap.to(el, {\n      y: 0,\n      opacity: 1,\n      duration: 1.2,\n      ease: \"power3.out\",\n      scrollTrigger: {\n        trigger: el,\n        start: \"top 85%\"\n      }\n    });\n  });\n\n  // Header Color Switching\n  const sections = gsap.utils.toArray('section');\n  sections.forEach(section => {\n    const isDark = section.id === 'hero-section' || section.classList.contains('bg-[#080808]');\n    ScrollTrigger.create({\n      trigger: section,\n      start: \"top 60px\",\n      onEnter: () => updateHeader(isDark),\n      onEnterBack: () => updateHeader(isDark)\n    });\n  });\n\n  function updateHeader(isDark) {\n    const header = document.querySelector('#main-nav');\n    const btnSignIn = header.querySelector('.nav-btn-signin');\n    const btnDemo = header.querySelector('.nav-btn-demo');\n    header.classList.toggle('is-light', !isDark);\n\n    if (isDark) {\n      btnSignIn.classList.remove('bg-black/5'); btnSignIn.classList.add('bg-white/10');\n      btnDemo.classList.remove('bg-black'); btnDemo.classList.add('bg-white');\n    } else {\n      btnSignIn.classList.add('bg-black/5'); btnSignIn.classList.remove('bg-white/10');\n      btnDemo.classList.add('bg-black'); btnDemo.classList.remove('bg-white');\n    }\n  }\n\n  // Database Background Drift\n  gsap.to(\"#database-bg-img\", {\n    yPercent: 20,\n    ease: \"none\",\n    scrollTrigger: {\n      trigger: \"#database-bg-img\",\n      start: \"top bottom\",\n      end: \"bottom top\",\n      scrub: true\n    }\n  });\n\n  // Pinning for Feature Rows\n  gsap.utils.toArray('.feature-row-pinned').forEach((row, i) => {\n    ScrollTrigger.create({\n      trigger: row,\n      start: \"top top\",\n      pin: true,\n      pinSpacing: false,\n      end: () => `+=${window.innerHeight}`,\n      onEnter: () => {\n         gsap.to(row, { opacity: 1, duration: 0.5 });\n      }\n    });\n  });\n\n  // Prefers Reduced Motion\n  if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {\n    gsap.globalTimeline.clear();\n    document.querySelectorAll('.reveal-up').forEach(el => gsap.set(el, {y:0, opacity:1}));\n    ScrollTrigger.getAll().forEach(t => t.kill());\n  }\n</script>\n",
